# Google AI Studio API key. Server-side only — never prefix with NEXT_PUBLIC_.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ids. Kept in env because the Gemini model line moves quickly and
# swapping one should be a config change, not a code change.
# Analysis and checklist need document understanding; Q&A is a grounded lookup
# over text we already extracted, so it runs on the cheaper lite model.
GEMINI_MODEL_ANALYZE=gemini-3.6-flash
GEMINI_MODEL_QA=gemini-3.5-flash-lite

# Neon Postgres connection string (pooled). Optional in development: without it
# the app still analyses documents, it just cannot save or share them.
# https://console.neon.tech
DATABASE_URL=
